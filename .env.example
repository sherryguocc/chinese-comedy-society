# Environment Variables - Copy to .env.local and fill in your values
# 环境变量 - 复制到 .env.local 并填入您的值

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 服务端专用（绕过 RLS），绝不能加 NEXT_PUBLIC_ 前缀，也不要提交到 git
# Server-only (bypasses RLS). Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Next.js Configuration
NEXTAUTH_URL=http://localhost:3000